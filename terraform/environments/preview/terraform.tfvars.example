# Copy to terraform.tfvars (gitignored) and fill in values.
# export CLOUDFLARE_API_TOKEN=...  # or set cloudflare_api_token here

cloudflare_account_id = "your-account-id"

access_team_domain = "myteam.cloudflareaccess.com"
# When enable_access = false, set AUD from the Access dashboard:
access_aud = "preview-access-aud-replace-me"

admin_emails    = "you@example.com"
public_base_url = "https://preview.example.com"
public_hostname = "share-preview.example.com"

# Optional: Terraform creates the Access app + admin allow policy
enable_access = false
app_hostname  = "preview.example.com"

# Optional DNS (set worker_cname_target after first wrangler deploy)
zone_id             = ""
worker_cname_target = ""